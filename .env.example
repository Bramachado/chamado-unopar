# Configurações do Supabase
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# Chave de criptografia de 32 bytes em base64 (gerar com: openssl rand -base64 32)
CRED_ENCRYPTION_KEY=

# Chave de assinatura das sessões (obrigatória em produção, mínimo 32 caracteres; gerar com: openssl rand -base64 48)
AUTH_SECRET=

# API do agente Prisma (/api/agente/*). Token com no mínimo 32 caracteres (openssl rand -hex 32)
# e ID de um perfil ativo em dados.perfis criado para o agente (ex.: "Agente Prisma", papel coordenador).
AGENTE_API_TOKEN=
AGENTE_PERFIL_ID=

# SQL Server (obrigatório). Na VPS o container acessa o host por 172.18.0.1.
# Localmente, use o IP Tailscale da VPS Edunorte (100.118.29.5).
MSSQL_HOST=100.118.29.5
MSSQL_PORT=1433
MSSQL_DATABASE=ChamadosUnopar
MSSQL_USER=app_chamados
MSSQL_PASSWORD=
