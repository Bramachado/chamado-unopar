# Configurações do Supabase
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# Chave do cofre de credenciais externas: 32 bytes em base64 (openssl rand -base64 32).
# OBRIGATÓRIA: não existe mais chave padrão no código. Trocar a chave exige recifrar o cofre
# (scripts/rotacionar-chave.md).
CRED_ENCRYPTION_KEY=

# Chave de assinatura das sessões (obrigatória em produção, mínimo 32 caracteres; gerar com: openssl rand -base64 48)
AUTH_SECRET=

# API do agente Prisma (/api/agente/*). Token com no mínimo 32 caracteres (openssl rand -hex 32)
# e ID de um perfil ativo em dados.perfis criado para o agente (ex.: "Agente Prisma", papel coordenador).
AGENTE_API_TOKEN=
AGENTE_PERFIL_ID=

# SQL Server (obrigatório). Na VPS o container acessa o host por 172.18.0.1.
# Localmente, use o IP Tailscale da VPS Edunorte (100.118.29.5).
MSSQL_HOST=100.118.29.5
MSSQL_PORT=1433
MSSQL_DATABASE=ChamadosUnopar
MSSQL_USER=app_chamados
MSSQL_PASSWORD=

# Fuso institucional para "hoje", virada do dia e exibição de horários (padrão America/Sao_Paulo).
# Os polos do Pará usam America/Belem (mesmo deslocamento -03:00 hoje). Definir antes do build,
# pois também é usado no navegador.
NEXT_PUBLIC_FUSO_INSTITUCIONAL=America/Sao_Paulo

# Quantidade de proxies confiáveis à frente da aplicação para ler o IP do cliente em
# X-Forwarded-For (auditoria e limite de login). 0 = ignora o cabeçalho. Easypanel/Traefik: 1.
PROXIES_CONFIAVEIS=0

# Banco de TESTES local (db/teste/preparar.ts, npm run test:integracao). Nunca use produção.
# TESTE_DB_PORTA=14333
# TESTE_DB_SA_SENHA=
# TESTE_APP_SENHA=
